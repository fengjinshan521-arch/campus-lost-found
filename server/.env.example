# 复制本文件为 .env 后按实际修改。.env 已在 .gitignore 中，禁止提交。
FLASK_ENV=development

# 安全密钥：务必改成随机串（生成命令：python -c "import secrets;print(secrets.token_hex(32))"）
SECRET_KEY=please-change-this-to-a-random-32-bytes-string

# MySQL 8.0 连接串：将 YOUR_DB_PASSWORD 替换为你本机 root 密码（真实密码只写在 .env，不入库）
# 注意：密码含 @ # ! 等特殊字符必须 URL 编码，例如 @ 写成 %40
DATABASE_URL=mysql+pymysql://root:YOUR_DB_PASSWORD@127.0.0.1:3306/campus_lostfound?charset=utf8mb4

# 上传与账号安全
UPLOAD_FOLDER=instance/uploads
MAX_UPLOAD_MB=5
LOGIN_MAX_RETRY=5
LOGIN_LOCK_MINUTES=10
PASSWORD_MIN_LEN=8

# 前端开发服务器地址（CORS 允许来源，多个用逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 匹配算法权重（六因子，总和建议为 1.0）
W_CATEGORY=0.25
W_KEYWORD=0.20
W_LOCATION=0.15
W_TIME=0.15
W_FEATURE=0.15
W_TEXT=0.10
MATCH_THRESHOLD=0.45
